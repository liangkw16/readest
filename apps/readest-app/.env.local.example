# Optional self-hosted web API origin. Leave empty to use same-origin /api routes.
NEXT_PUBLIC_API_BASE_URL=

# Optional self-hosted OPDS proxy origin. Leave empty to use the same web deployment.
NEXT_PUBLIC_NODE_BASE_URL=

# Optional BYO OAuth registrations. Leave empty to hide Google Drive/OneDrive.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=

# Optional self-hosted directory containing CJK font bundles.
NEXT_PUBLIC_FONT_BASE_URL=

# Optional user-hosted directory containing WordLens manifest.json and packs.
# Leave empty to keep WordLens local-only.
NEXT_PUBLIC_WORDLENS_BASE_URL=

# Optional metadata search key for a self-hosted deployment.
GOOGLE_BOOKS_API_KEYS=
