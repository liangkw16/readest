# Personal fork image and host port.
READEST_IMAGE=ghcr.io/liangkw16/readest:latest
READEST_PORT=3000

# Public origin of this web client. Change this when serving through HTTPS.
SITE_URL=http://localhost:3000

# Optional user-owned service endpoints. Empty means same-origin `/api`.
API_BASE_URL=
NODE_BASE_URL=

# Optional directories containing self-hosted CJK font bundles and WordLens
# manifest/pack files. Empty disables network downloads for those assets.
FONT_BASE_URL=
WORDLENS_BASE_URL=

# Optional comma-separated Google Books API keys for metadata search.
GOOGLE_BOOKS_API_KEYS=
