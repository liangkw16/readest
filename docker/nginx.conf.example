# Example nginx site config for serving the accountless client over HTTPS.
#
# Copy this file into your nginx sites directory, replace your-domain.com and
# the certificate paths, then set SITE_URL=https://your-domain.com in .env.
# Bind READEST_PORT to a loopback-only host port if nginx is the only public
# entry point (for example, use a separate compose override with
# `127.0.0.1:3000:3000`).

server {
    listen 80;
    listen [::]:80;
    server_name your-domain.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    # nginx < 1.25.1 wants `listen 443 ssl http2;` above instead.
    http2 on;
    server_name your-domain.com;

    ssl_certificate     /etc/letsencrypt/live/your-domain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.com/privkey.pem;

    # The client and its built-in API routes share one origin. There are no
    # Supabase, login, database, or object-storage routes to proxy.
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Optional: serve user-hosted asset bundles from this same origin and set
    # FONT_BASE_URL / WORDLENS_BASE_URL to the matching public paths.
    # location /fonts/ {
    #     alias /srv/readest/fonts/;
    # }
    # location /wordlens/ {
    #     alias /srv/readest/wordlens/;
    # }
}
